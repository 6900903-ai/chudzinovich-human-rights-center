{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chudzinovich.pp.ua/schemas/snapshot-manifest.schema.json",
  "title": "Published Snapshot Manifest",
  "type": "object",
  "required": ["snapshot_id", "created_at", "publication_state", "counts", "files"],
  "properties": {
    "snapshot_id": {"type": "string", "pattern": "^snap-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "publication_state": {"enum": ["DEVELOPMENT_EMPTY", "PUBLISHED"]},
    "counts": {
      "type": "object",
      "required": ["people", "political_prisoners_current", "former_political_prisoners", "repressed_total"],
      "properties": {
        "people": {"type": "integer", "minimum": 0},
        "political_prisoners_current": {"type": "integer", "minimum": 0},
        "former_political_prisoners": {"type": "integer", "minimum": 0},
        "repressed_total": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "source_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "observed_at"],
        "properties": {
          "source_id": {"type": "string"},
          "observed_at": {"type": "string", "format": "date-time"},
          "source_manifest_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "source_page_url": {"type": ["string", "null"], "format": "uri"},
          "source_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "parsed_rows": {"type": ["integer", "null"], "minimum": 0},
          "clean_rows": {"type": ["integer", "null"], "minimum": 0},
          "quarantined_rows": {"type": ["integer", "null"], "minimum": 0},
          "review_required_findings": {"type": ["integer", "null"], "minimum": 0},
          "identity_resolution_applied": {"type": "boolean"},
          "identity_resolution_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "candidate_snapshot_id": {"type": ["string", "null"], "pattern": "^snap-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"},
          "candidate_manifest_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "candidate_audit_receipt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "candidate_build_audit_receipt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
